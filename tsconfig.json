{
  "compilerOptions": {
    "types": [
      "node"
    ],
    "outDir": "dist",
    "target": "ES2022",
    "noEmit": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "moduleResolution": "Bundler",
    "module": "ESNext"
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "**/*.mts"],
  "exclude": ["node_modules", "**/node_modules", "**/dist"]
}
