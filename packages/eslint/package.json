    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependencies": {
    "typescript": ">=4.8.4 <6.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.8",
    "esbuild": "^0.21.4",
    "rollup": "^4.18.0",
    "rollup-plugin-esbuild": "^6.1.1"
  }
