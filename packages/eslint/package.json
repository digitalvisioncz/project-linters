  },
  "type": "module",
  "scripts": {
    "start": "rollup --config=rollup.config.mts --configPlugin=rollup-plugin-esbuild --watch",
    "build": "rollup --config=rollup.config.mts --configPlugin=rollup-plugin-esbuild"
